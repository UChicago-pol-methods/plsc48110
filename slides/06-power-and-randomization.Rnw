%-------------------------------------------------------------------------------%
\begin{frame}{Considerations when running an experiment}

\begin{itemize}
\item What hypotheses are you testing?  And what estimation techniques used to test them?
\item What proportion of subjects in treatment vs. control?  Or, with multiple conditions, what proportion in each?
\item Oversampling some sub-populations?
\item (Replicable) methods for randomization  (is your study online? in person? do you have the full sample frame ex ante?)
\item Also: ethical considerations, cost, implementation barriers
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Sample frame}

\begin{itemize}
\item Who is included in your study? How are they selected?
\item Random selection?  Clustered selection ? (e.g., schools, neighborhoods)  Somehow representative of a population?  Convenience sample?  Eligibility criteria?
\item Important for both internal and external validity.
\item Approaches to creating a sample frame:
\begin{itemize}
\item Administrative data (census, school registers, health data)
\item Do your own census/mapping exercise
\item "Random walk"
\item Ongoing enrollment: online population, people at a health clinic;  generally have eligibility criteria
\end{itemize}
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%

\begin{frame}{Randomization procedures}

\begin{itemize}
\item Simple random assignment
\item Complete random assignment
\item Stratified random assignment
\item Paired random assignment
\item Clustered random assignment
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Randomization procedures: mechanisms}

\begin{itemize}
\item Is it replicable?  Is it public?  What could go wrong?
\item Lottery
\item Random walk
\item Computer program
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Simple random assignment}

\begin{itemize}
\item Treatment assignment probabilities are the same across units
\item Treatment is assigned to each unit independently
\item Not optimal for estimation $\rightarrow$ can have chance imbalance in treatment and control.
\item But sometimes required in practice, e.g., when you don't have your entire sample frame prior to starting the experiment
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Complete random assignment}

\begin{itemize}
\item Fix the number/proportion of units in treatment and control, then randomize over sample frame.
\item We can still get chance imbalance on measured and unmeasured variables.
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Stratified random assignment}

\begin{itemize}
\item Divide your sample frame into subgroups.  Apply complete random assignment \textit{within} subgroups.
\item Benefits: removes chance of imbalance on \textit{measured} variables.  Especially useful if we want to look at treatment effects within subgroups.
\item Sometimes different strata have different assignment probabilities.
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Stratified random assignment}

\begin{itemize}
\item How do you decide what variables to stratify on, and where to bin continuous variables?
\item Variable should correlate with outcome variable.
\item For binning, can use statistical methods (e.g., decision trees).
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Clustered random assignment}

\begin{itemize}
\item Divide your sample into subgroups.
\item Assign treatment uniformly within subgroups.  (Or at fixed levels of treatment intensity.)
\item Bias-variance trade-off.
\item Useful when there is spillover, and/or you're interested in what a program would look like if implemented uniformly at scale.
\item Setting different levels of treatment intensity can facilitate estimating spillovers as well as direct effects. \citep{baird2018optimal}
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{What about re-randomization?}

\begin{itemize}
\item What are criteria?
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Power}

\begin{itemize}
\item How large does my experiment need to be for my proposed statistical procedure to be informative?  (under certain conditions)
\item The test can be about distinguishing treatment effects from zero, but it doesn't \textit{have} to be.
\item Hypothesis: alternative vs. null.
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Power}

\begin{itemize}
\item Type I error: falsely reject the null. Probability in terms of $\alpha$.
\item Type II error: fail to detect an effect when it exists. Probability in terms of $\beta$.
\item Power: probability of rejecting a "false null hypothesis."  I.e., given that there \textit{is} an effect, do you correctly reject the null? Probability in terms of $1 - \beta$.  Often, we target power of $1-\beta$.
\item Minimum detectable effect: the smallest effect that would produce our target power, given a specific statistical test and a given $\alpha$.  Selection often informed by substantive knowledge or policy relevance.
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Power}

\begin{figure}
\centering
\includegraphics[]{assets/power_plot.png}
\end{figure}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Power}

Note: power is with respect to:
\begin{itemize}
\item Statistical elements: a given statistical test, a given $\alpha$, a given minimum detectable effect size, a given sample size.  We also need to specify the statistical distribution of our response variable.
\begin{itemize}
\item Distributions: normal, binomial.  Intra-cluster correlation?
\end{itemize}
\item Design elements: sample size, treatment allocation.
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}[fragile]{Example}

\scriptsize
<<code-01>>=
library(ggplot2)
library(estimatr) # for lin estimator
set.seed(60637) # setting a seed is important
complete_assign <- function(n){
  nt <- n %/% 2 + rbinom(1, 1, n %% 2)
  sample(rep(c(0, 1), c(n - nt, nt)))
}
@


\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Example}

You can use the \texttt{randomizr} package in \texttt{R}. It has functions like \texttt{complete\_ra()} to implement complete random assignment.

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Example}

Suppose:
\begin{itemize}
\item We have $n = 100$ observations in our sample.
\item We assign treatment $W$ to half of the sample using complete random assignment.
\item There is an $X$ variable distributed $\mathcal{N}(0,1)$
\item The treatment effect $\tau$ is equal to 2.
\item Individual response follows:
\[
Y = 3X + \tau \times W + \epsilon
\]
Where $\epsilon$ is random noise distributed $\mathcal{N}(0,1)$.
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%

\begin{frame}[fragile]{Example}

\scriptsize
<<code-02>>=
n <- 1e2
W <- complete_assign(n)
X <- rnorm(mean = 0, sd = 1, n = n)
tau <- 2
Y <- 3*X + tau*W + rnorm(mean = 0, sd = 1, n = n)
@


\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}[fragile]{Example}

We consider both $X$, and a dichotomized variable $\tilde X$, which is 1 when $X>0$ and 0 if $X<0$.

\scriptsize
<<code-03>>=
Xtilde <- 1*(X>0)
@



<<code-04>>=
dat <- data.frame(Y, W, X, Xtilde)
head(dat)
@

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}[fragile]{Example}

We can estimate our treatment effect as a difference in means.

\scriptsize
<<code-05>>=
difference_in_means(Y ~W, data = dat) # from estimatr
@


<<code-06>>=
mean(Y[W == 1] - mean(Y[W == 0])) # equivalent
@


\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{Example}

\begin{itemize}
\item How is precision affected if we had used a different design?  A different estimator?
\item We will consider simple random assignment, complete random assignment, stratified random assignment, and paired random assignment.
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}[fragile]{Example}

\scriptsize
<<code-07>>=
niter <- 1e4
estimates <- estimates_alt <- power <- power_alt <- matrix(NA,
  nrow = niter,
  ncol = 4)
colnames(estimates) <- colnames(estimates_alt) <- colnames(power) <-
  colnames(power_alt) <- c('simple', 'complete', 'stratified', 'paired')
@


\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}[fragile]{Simulation: Simple random assignment}
\scriptsize
<<code-08, cache=TRUE, cache.extra=list(n,tau,niter,body(complete_assign),as.character(packageVersion("estimatr")))>>=
set.seed(60637)
for (i in 1:niter) {
  X <- rnorm(mean = 0, sd = 1, n = n)
  Xtilde <- 1*(X>0)

  # Simple random assignment
  W <- sample(0:1, size = n, replace = TRUE)
  Y <- 3*X + tau*W + rnorm(mean = 0, sd = 1, n = n)

  est0 <- difference_in_means(Y~W, data = data.frame(Y, W))
  est1 <- lm_lin(Y~W, covariates = formula('~ Xtilde'),
                 data = data.frame(Y, W, Xtilde))
  estimates[i, 1] <- coef(est0)
  power[i, 1] <- (est0$conf.low > 0 | est0$conf.high < 0)
  estimates_alt[i, 1] <- coef(est1)[['W']]
  power_alt[i, 1] <- (est1$conf.low['W'] > 0 | est1$conf.high['W'] < 0)
}
@
\end{frame}

\begin{frame}[fragile]{Simulation: Complete random assignment}
\scriptsize
<<code-09, cache=TRUE, cache.extra=list(n,tau,niter,body(complete_assign),as.character(packageVersion("estimatr"))), dependson="code-08">>=
set.seed(60638)
for (i in 1:niter) {
  X <- rnorm(mean = 0, sd = 1, n = n)
  Xtilde <- 1*(X>0)

  # Complete random assignment
  W <- complete_assign(n)
  Y <- 3*X + tau*W + rnorm(mean = 0, sd = 1, n = n)

  est0 <- difference_in_means(Y~W, data = data.frame(Y, W))
  est1 <- lm_lin(Y~W, covariates = formula('~ Xtilde'),
                 data = data.frame(Y, W, Xtilde))
  estimates[i, 2] <- coef(est0)
  power[i, 2] <- (est0$conf.low > 0 | est0$conf.high < 0)
  estimates_alt[i, 2] <- coef(est1)[['W']]
  power_alt[i, 2] <- (est1$conf.low['W'] > 0 | est1$conf.high['W'] < 0)
}
@
\end{frame}

\begin{frame}[fragile]{Simulation: Stratified random assignment}
\scriptsize
<<code-10, cache=TRUE, cache.extra=list(n,tau,niter,body(complete_assign),as.character(packageVersion("estimatr"))), dependson="code-09">>=
set.seed(60639)
for (i in 1:niter) {
  X <- rnorm(mean = 0, sd = 1, n = n)
  Xtilde <- 1*(X>0)

  # Stratified random assignment
  W <- rep(NA, n)
  W[which(Xtilde == 0)] <-  complete_assign(sum((Xtilde == 0)))
  W[which(Xtilde == 1)] <-  complete_assign(sum((Xtilde == 1)))
  Y <- 3*X + tau*W + rnorm(mean = 0, sd = 1, n = n)

  dat <- data.frame(Y, W, Xtilde)
  est0 <- difference_in_means(Y~W, blocks = Xtilde, data = dat)
  est1 <- lm_lin(Y~W, covariates = ~ Xtilde, data = dat)
  estimates[i, 3] <- coef(est0)
  power[i, 3] <- (est0$conf.low > 0 | est0$conf.high < 0)
  estimates_alt[i, 3] <- coef(est1)[['W']]
  power_alt[i, 3] <- (est1$conf.low['W'] > 0 | est1$conf.high['W'] < 0)
}
@
\end{frame}

\begin{frame}[fragile]{Simulation: Paired random assignment}
\scriptsize
<<code-11, cache=TRUE, cache.extra=list(n,tau,niter,body(complete_assign),as.character(packageVersion("estimatr"))), dependson="code-10">>=
set.seed(60640)
for (i in 1:niter) {
  X <- rnorm(mean = 0, sd = 1, n = n)
  Xtilde <- 1*(X>0)

  # Pair adjacent units in sorted X
  pair <- integer(n)
  pair[order(X)] <- rep(seq_len(n/2), each = 2)
  W[order(X)] <- as.vector(replicate(n/2, sample(0:1)))
  Y <- 3*X + tau*W + rnorm(mean = 0, sd = 1, n = n)

  dat <- data.frame(Y, W, Xtilde, pair)
  est0 <- difference_in_means(Y~W, blocks = pair, data = dat)
  est1 <- lm_lin(Y~W, covariates = ~ Xtilde,
                 clusters = pair, data = dat)
  estimates[i, 4] <- coef(est0)
  power[i, 4] <- (est0$conf.low > 0 | est0$conf.high < 0)
  estimates_alt[i, 4] <- coef(est1)[['W']]
  power_alt[i, 4] <- (est1$conf.low['W'] > 0 | est1$conf.high['W'] < 0)
}
@
\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
% Each preceding simulation frame is an executable loop with its own seed.
<<check-simulation, include=FALSE>>=
stopifnot(all(is.finite(estimates)), all(is.finite(estimates_alt)),
          all(power %in% c(0, 1)), all(power_alt %in% c(0, 1)))
@



%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%

\begin{frame}{Matching inference to the design}
\begin{itemize}
\item For stratified and paired assignment, pass the stratum or pair identifier to \texttt{difference\_in\_means()} using \texttt{blocks}.
\item The Lin regression includes centered $\tilde X$ and its interaction with treatment. For stratification on $\tilde X$, this fits a separate treatment effect within each stratum.
\item For paired assignment, use pair-clustered standard errors in the Lin regression to account for dependence within pairs.
\item Power below is the rejection rate of a two-sided test at $\alpha=0.05$ when the true effect is 2.
\end{itemize}
\end{frame}

\begin{frame}[fragile]{Simulation results: variation}

\scriptsize
Variation of the estimate
<<code-12>>=
apply(estimates, 2, sd) # using difference in means estimate
apply(estimates_alt, 2, sd) # using lin estimator
@

\end{frame}

\begin{frame}[fragile]{Simulation results: power}
\scriptsize
<<code-13>>=
apply(power, 2, mean) # using difference in means estimate
apply(power_alt, 2, mean) # using lin estimator
@

\end{frame}


