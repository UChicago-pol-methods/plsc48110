%-------------------------------------------------------------------------------%
\begin{frame}{Regression Trees}

\begin{itemize}
\item Now suppose we have joint data, $(Y,X_1, \dots, X_k)$.
\item We will do the same approach to finding thresholds to minimize prediction error, but we'll want to pick which $X_k$ we use for threshholding, as well.
\item Generally, we'll define the depth of the tree as 2 or three variables; first we'll split on $X_k$, then we'll split on $X_j$\dots
\end{itemize}


\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}{Regression Trees}

\begin{itemize}
\item If we want to find a splitting point with respect to something other than mean response, such as treatment effects, we can target the treatment effect estimator instead of $Y_i$.
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}
\\~\
}

%-------------------------------------------------------------------------------%
\begin{frame}{Honesty}

\begin{itemize}
\item Returning to (causal) inference\dots  we might like to use these methods to get valid inference, potentially on causal targets.
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}{An honest tree algorithm}

\begin{enumerate}
\item Split the sample into two folds.
\item Use the first fold to learn splits of the tree.
\item Estimate response within leaves using the second fold.
\end{enumerate}

\begin{itemize}
\item This can result in some leaves being empty.  Prune them?
\item This procedure reduces bias relative to those proposed by \cite{breiman2001random}.
\end{itemize}

\end{frame}


%%%%%NOTE%%%%%
\note{
\scriptsize \singlespacing

\begin{itemize}
\item xxxx
\end{itemize}

}

%-------------------------------------------------------------------------------%
\begin{frame}[fragile]{An honest tree algorithm}

<<code-02, eval=FALSE>>=
library(grf)
set.seed(60637)
n <- 500
p <- 10
X <- matrix(rnorm(n * p), n, p)
W <- rbinom(n, 1, 0.5)
Y <- pmax(X[, 1], 0) * W + X[, 2] +
  pmin(X[, 3], 0) + rnorm(n)
c.forest <- causal_forest(X, Y, W)
@



\end{frame}


